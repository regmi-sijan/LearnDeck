# Copy this file to .env (start.sh does it for you), or set keys from the app's Settings panel.

# Which AI to use: free | auto | anthropic | openai | ollama | none
#   free  = Groq, then Gemini, then OpenRouter, then Ollama (switches when a free limit is reached)
#   auto  = Claude if ANTHROPIC_API_KEY is set, else OpenAI, else the free services if any free key is set,
#           else simple mode
LLM_PROVIDER=auto

# --- Free services (used in this order; any without a key are skipped)
FREE_CHAIN=groq,gemini,openrouter,ollama
# https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Document text sent per request; Groq's free plan allows ~8,000 tokens a minute
GROQ_INPUT_CHARS=12000
# https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# https://openrouter.ai/keys  (openrouter/free picks a free model for each request)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
# Wait out per-minute limits this short (seconds) instead of switching service
FREE_WAIT_SECONDS=12

# --- Claude (recommended) -- get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=
# claude-sonnet-5-5 is a good balance; claude-opus-5-5 is the most capable; claude-haiku-5-5 is fastest and cheapest
ANTHROPIC_MODEL=claude-sonnet-5-5

# --- OpenAI, or an OpenAI-compatible server such as LM Studio (set OPENAI_BASE_URL)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
# OPENAI_BASE_URL=http://localhost:1234/v1

# --- Ollama (free, runs locally; install from https://ollama.com, then: ollama pull qwen3.5:9b)
#     8 GB Mac: qwen3.5:4b   16 GB: qwen3.5:9b   32 GB+: qwen3.5:27b
OLLAMA_MODEL=qwen3.5:9b
OLLAMA_URL=http://localhost:11434
OLLAMA_NUM_CTX=16384

# --- Lesson options
# How many levels you can drill below the overview
MAX_DEPTH=4
# Language the explanations are written in
EXPLAIN_LANGUAGE=English
# Pre-write this many child slides in the background after each slide (faster clicking, more API usage)
PREFETCH_CHILDREN=0
# Scanned pages / images read with AI vision per document
VISION_PAGE_LIMIT=40

# --- Server
PORT=8765
HOST=127.0.0.1
MAX_UPLOAD_MB=300
OPEN_BROWSER=true
# DATA_DIR=./data
